{
  "name": "circle-of-fifths",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "circle-of-fifths": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --external:commander --outfile=dist/cli.js",
    "generate": "node --import tsx src/cli.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@circle-of-fifths/svg": "workspace:*",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=20"
  }
}
